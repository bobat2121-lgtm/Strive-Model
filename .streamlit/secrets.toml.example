# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud -> app settings -> Secrets.
# Optional: the capital-report feed (weekly 8-K facts). Without it the app uses the bundled snapshot in data/seed/.
FILINGS_FEED_URL = "https://<your-worker>.workers.dev/api/filings"

# Owner panel (the sidebar's "Owner" section): the password that unlocks publishing the live price target.
# Without it, publishing is off. Use a long random password.
OWNER_PASSWORD = "<a long random password>"
# Makes a published target permanent: a fine-grained GitHub token with Contents: read and write on this repo only.
# Without it, a published target lasts until the app restarts.
GITHUB_TOKEN = "github_pat_<...>"
